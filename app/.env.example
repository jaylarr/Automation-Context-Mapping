# Copy to .env.local and fill in. .env.local is gitignored. Never commit real values.

# --- n8n instances --------------------------------------------------------------
# Add them in the app: Settings -> n8n instances -> Add instance (name, URL, API key).
# Each key is stored here automatically as N8N_API_KEY__<INSTANCE_ID>. No need to edit by hand.

# --- Webhook event inbox ------------------------------------------------------
# Shared secret n8n workflows send in the "x-ingest-token" header when POSTing to /api/events.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_TOKEN=

# --- Optional -------------------------------------------------------------------
# Workspace root (defaults to the folder above app/).
# WORKSPACE_ROOT=
# SQLite file (defaults to app/data/control-center.db).
# DATABASE_PATH=

# Extra host names the app answers to (comma-separated, no ports). Built in: 127.0.0.1, localhost,
# [::1], host.docker.internal. Anything else gets 421, which blocks DNS-rebinding attacks.
# CONTROL_CENTER_HOSTS=
