{
  "name": "automation-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "Local control center for the automation workspace: projects, workflows, logs, docs.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "typecheck": "next typegen && tsc --noEmit",
