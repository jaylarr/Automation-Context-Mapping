{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create_workflow_from_code|update_workflow|publish_workflow|unpublish_workflow|archive_workflow|test_workflow|execute_workflow)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/n8n-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
